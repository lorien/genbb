# GenBB reverse proxy. TLS lines are commented until certs are issued.
server {
    listen 80;
    listen [::]:80;
    server_name genbb.org;

    # Let's Encrypt webroot challenge
    # (certbot: authenticator=webroot, webroot-path=/web)
    location ^~ /.well-known/acme-challenge/ {
        root /web;
        default_type "text/plain";
    }

    location / {
        proxy_pass http://127.0.0.1:8070;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # ---- TLS (uncomment after certbot issues certs) ----
    # listen 443 ssl;
    # ssl_certificate /etc/letsencrypt/live/genbb.org/fullchain.pem;
    # ssl_certificate_key /etc/letsencrypt/live/genbb.org/privkey.pem;
    # server_tokens off;
}

